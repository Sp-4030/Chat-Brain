# =========================================================
# ChatBrain - Environment Configuration Template
# Copy this file to .env and adjust values as needed.
# =========================================================

# --- Ollama Local AI Settings ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TEMPERATURE=0.8
OLLAMA_TIMEOUT=30.0
OLLAMA_MAX_RETRIES=2

# --- YouTube OAuth & API Settings ---
CLIENT_SECRET_FILE=client_secret.json
TOKEN_FILE=token.json
MIN_POLL_SECONDS=1.0
DEFAULT_POLL_INTERVAL_MILLIS=5000
ERROR_RETRY_SECONDS=10.0
MAX_CONSECUTIVE_ERRORS=5

# --- Reply & Rate Limiting Controls ---
MAX_REPLY_LENGTH=200
SMART_REPLY_FILTER=true
GLOBAL_REPLY_COOLDOWN_SECONDS=3.0
USER_REPLY_COOLDOWN_SECONDS=10.0
MAX_REPLIES_PER_USER_WINDOW=3
USER_WINDOW_SECONDS=60.0
MAX_CONTEXT_TURNS=5
MAX_MEMORY_CACHE_SIZE=2000

# --- Humor & Personality ---
HUMOR_ENABLED=true
HUMOR_INTENSITY=0.7

# --- Streamer Persona Details ---
STREAMER_NAME=Shantanu
STREAMER_LOCATION=Kolhapur, Maharashtra, India
STREAMER_EDUCATION=BCA completed
STREAMER_INTERESTS=AI/ML, Python, DSA, Data Science and technology

# --- Storage & Logging ---
HISTORY_FILE=chat_history.jsonl
LOG_FILE=chatbrain.log
LOG_LEVEL=INFO
